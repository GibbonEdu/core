msgid "Import Student Enrolment"
msgstr "Nhập Học viên Nhập học"

#: modules/User Admin/import_studentEnrolment.php:52
#: Admin/import_studentEnrolment.php:50 .git/modules/User
#: .git/modules/User Admin/import_studentEnrolment.php:50
#: modules/User Admin/import_studentEnrolment.php:51
msgid ""
"This page allows you to import student enrolment data from a CSV file, in "
"one of two modes: 1) Sync - the import file includes all students. The "
"system will take the import and delete enrolment for any existing students "
"not present in the file, whilst importing new enrolments into the system, or "
"2) Import - the import file includes only student enrolments you wish to add "
"to the system. Select the CSV file you wish to use for the synchronise "
"operation."
msgstr ""
"Trang này cho phép bạn nhập dữ liệu đăng ký nhập học viên từ một tệp tin "
"CSV, trong một trong hai chế độ: 1) Đồng bộ hóa - tệp nhập bao gồm tất cả "
"học viên. Hệ thống sẽ thực hiện việc nhập và xóa đăng ký cho bất kỳ học viên "
"hiện có nào không có trong tệp, trong khi nhập các đăng ký mới vào hệ thống "
"hoặc 2) Nhập - tệp nhập chỉ bao gồm các đăng ký học viên mà bạn muốn thêm "
"vào hệ thống. Chọn tệp tin CSV bạn muốn sử dụng cho thao tác đồng bộ hóa."

