# ============================================================
# Gibbon developer Docker environment
# Copy this file to .env in the repository root before ./up.sh
# This stack is for local development only, not production.
# ============================================================

## PHP version used to build the app image. Examples: 8.2, 8.3
PHP_VERSION=8.3

## MySQL image version
MYSQL_VERSION=8.0

## Database credentials (installer step 2 uses these)
MYSQL_HOST=gibbon_db
MYSQL_DATABASE=gibbon
MYSQL_USER=gibbon
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

## Browser URL for the running app
ABSOLUTE_URL=http://localhost:8080

## URL used by Codeception from the test container (resolves to the app service)
TEST_ABSOLUTE_URL=http://gibbon.test
TEST_ENV=codeception

# Optional Gibbon settings applied by setup_devdb.sh
TIMEZONE=UTC
CURRENCY='HKD $'
ORGANISATION_NAME='Gibbon Testing'
ORGANISATION_NAME_SHORT='GiT'
ORGANISATION_EMAIL=testing@gibbon.test
COUNTRY='Hong Kong'
EMAIL_LINK=
WEB_LINK=
ANALYTICS=

## For generated config.php
GUID=wocin5trm-vitd-iws-g2k-3huw6nzxtfp
CACHING_FACTOR=10
