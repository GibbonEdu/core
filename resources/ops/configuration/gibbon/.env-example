# ============================================================
# Gibbon Docker Environment Configuration
# ============================================================
# Copy this file to .env and adjust values before running.
# The up.sh helper will auto-create .env from this file if needed.
# The .env file is automatically read by Docker Compose.
# ============================================================

## PHP version used to build the app image. Examples: 8.2, 8.3
PHP_VERSION=8.3

## MySQL image version
MYSQL_VERSION=8.0

## Database credentials
MYSQL_HOST=gibbon_db
MYSQL_DATABASE=gibbon
MYSQL_USER=gibbon
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

## For config.php
GUID=wocin5trm-vitd-iws-g2k-3huw6nzxtfp
CACHING_FACTOR=10

## Docker Compose file selection — lets you run `docker compose` commands
COMPOSE_FILE=resources/ops/compose.yaml:resources/ops/compose.dev.yaml
