# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gibbon
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=gibbon
DATABASE_USER=root
DATABASE_PASSWORD=password

# JWT配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis配置
REDIS_URL=redis://localhost:6379/0

# DeepSeek AI配置（国内可访问：platform.deepseek.com）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云短信配置（替代Google SMS）
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=教育管理平台
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXX

# 支付宝配置（替代PayPal）
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=alipay-public-key

# 微信支付配置（替代Stripe）
WECHAT_APP_ID=your-wechat-app-id
WECHAT_MCH_ID=your-wechat-merchant-id
WECHAT_API_KEY=your-wechat-api-key

# 阿里云OSS配置（替代本地存储）
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=edusys-files
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 应用配置
APP_NAME=教育管理平台
APP_VERSION=2.0.0
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
